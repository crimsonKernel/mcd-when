{
  "mcpServers": {
    "mcd-when": {
      "command": "python",
      "args": ["src/mcp_server.py"],
      "env": {
        "PYTHONIOENCODING": "utf-8"
      }
    },
    "mcd-mcp": {
      "type": "streamablehttp",
      "url": "https://mcp.mcd.cn",
      "headers": {
        "Authorization": "Bearer ${MCD_MCP_TOKEN}"
      }
    }
  }
}
